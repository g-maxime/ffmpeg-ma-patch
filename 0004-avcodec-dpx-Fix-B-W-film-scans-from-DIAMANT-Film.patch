From 6950ef9684335c6f6ac9cef53d1edd73719bc690 Mon Sep 17 00:00:00 2001
From: Jerome Martinez <jerome@mediaarea.net>
Date: Thu, 4 Jul 2024 10:45:57 +0200
Subject: [PATCH 04/19] avcodec/dpx: Fix B&W film scans from DIAMANT-Film

---
 libavcodec/dpx.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/libavcodec/dpx.c b/libavcodec/dpx.c
index 6e7c01fd65..6f8cc3b75f 100644
--- a/libavcodec/dpx.c
+++ b/libavcodec/dpx.c
@@ -616,6 +616,7 @@ static int decode_frame(AVCodecContext *avctx, AVFrame *p,
     // Some devices do not pad 10bit samples to whole 32bit words per row
     dpx->unpadded_10bit = 0;
     if (!memcmp(input_device, "Scanity", 7) ||
+        !memcmp(creator, "DIAMANT-Film", 12) ||
         !memcmp(creator, "Lasergraphics Inc.", 18)) {
         if (avctx->bits_per_raw_sample == 10)
             dpx->unpadded_10bit = 1;
