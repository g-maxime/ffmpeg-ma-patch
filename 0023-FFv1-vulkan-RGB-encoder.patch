@@ -23,6 +23,17 @@
 #ifndef VULKAN_FFV1_COMMON_H
 #define VULKAN_FFV1_COMMON_H
 
+/* How the neighbour samples of the frame being coded are reached. Everything
+ * but the RGB range coder encoder reads and writes the image it was handed;
+ * that one keeps its colour-transform ring in a storage buffer instead (see
+ * ffv1_enc_rgb.comp.glsl), so it overrides these before including us. */
+#ifndef SURF_LOAD
+#define SURF_LOAD(surf, addr)     imageLoad((surf), (addr))
+#endif
+#ifndef SURF_STORE
+#define SURF_STORE(surf, addr, val) imageStore((surf), (addr), (val))
+#endif
+
 #ifdef GOLOMB
 #include "ffv1_vlc.glsl"
 #endif
@@ -224,9 +235,9 @@ ivec4 get_top(IMG_QUALI uimage2D pred, ivec2 sp, ivec2 off,
     ivec2 yoff_border1 = expectEXT(off.x == 0, false) ? off + ivec2(1, -1) : off;
 
     /* Thanks to the same coincidence as below, we can skip checking if off == 0, 1 */
-    VTYPE3 top  = VTYPE3(TYPE(imageLoad(pred, sp + LADDR(yoff_border1 + ivec2(-1, -1)))[comp]),
-                         TYPE(imageLoad(pred, sp + LADDR(off + ivec2(0, -1)))[comp]),
-                         TYPE(imageLoad(pred, sp + LADDR(off + ivec2(min(1, sw - off.x - 1), -1)))[comp]));
+    VTYPE3 top  = VTYPE3(TYPE(SURF_LOAD(pred, sp + LADDR(yoff_border1 + ivec2(-1, -1)))[comp]),
+                         TYPE(SURF_LOAD(pred, sp + LADDR(off + ivec2(0, -1)))[comp]),
+                         TYPE(SURF_LOAD(pred, sp + LADDR(off + ivec2(min(1, sw - off.x - 1), -1)))[comp]));
 
     TYPE top2 = TYPE(0);
     if (has_extend_lookup && extend_lookup) {
@@ -235,7 +246,7 @@ ivec4 get_top(IMG_QUALI uimage2D pred, ivec2 sp, ivec2 off,
         if (rgb_linecache != 2)
             top2_off += ivec2(0, -2);
 
-        top2 = TYPE(imageLoad(pred, sp + LADDR(top2_off))[comp]);
+        top2 = TYPE(SURF_LOAD(pred, sp + LADDR(top2_off))[comp]);
     }
 
     return ivec4(top, top2);
@@ -329,7 +340,7 @@ void linecache_load(IMG_QUALI uimage2D src, ivec2 sp, int y, uint comp)
     {
         TYPE c = TYPE(0);
         if (y > 0)
-            c = TYPE(imageLoad(src, sp + LADDR(ivec2(0, y - 1)))[comp]);
+            c = TYPE(SURF_LOAD(src, sp + LADDR(ivec2(0, y - 1)))[comp]);
         linecache[1] = c;
     }
 
