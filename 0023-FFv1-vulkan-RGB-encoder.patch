From 280197eb0fddbb266b0bf76c882bf861bf1bbc70 Mon Sep 17 00:00:00 2001
From: Maxime Gervais <gervais.maxime@gmail.com>
Date: Thu, 8 Oct 2026 20:17:46 +0000
Subject: [PATCH] Fix FFv1 vulkan RGB encoder

---
 libavcodec/ffv1enc_vulkan.c              | 87 ++++++++++++++++++++----
 libavcodec/vulkan/ffv1_common.glsl       | 21 ++++--
 libavcodec/vulkan/ffv1_enc.comp.glsl     | 49 +++++++------
 libavcodec/vulkan/ffv1_enc_rgb.comp.glsl | 39 ++++++++++-
 4 files changed, 157 insertions(+), 39 deletions(-)

diff --git a/libavcodec/ffv1enc_vulkan.c b/libavcodec/ffv1enc_vulkan.c
index 699df37b6d..3315a04a20 100644
--- a/libavcodec/ffv1enc_vulkan.c
+++ b/libavcodec/ffv1enc_vulkan.c
@@ -106,6 +106,10 @@ typedef struct VulkanEncodeFFv1Context {
     FFVkBuffer order_buf;
     uint32_t prev_size[MAX_SLICES];
     int have_prev;
+
+    /* RGB range coder ring buffer (see rgb_tmp_is_buffer()) */
+    FFVkBuffer rgb_tmp;
+    size_t rgb_tmp_size;
 } VulkanEncodeFFv1Context;
 
 static int cmp_slice_order(const void *a, const void *b)
@@ -114,6 +118,30 @@ static int cmp_slice_order(const void *a, const void *b)
     return (x < y) - (x > y);
 }
 
+/* Per-frame share of the results buffer. This is bound as a storage buffer at
+ * fd->idx*stride, so the stride has to be a multiple of
+ * minStorageBufferOffsetAlignment; (max_slice_count + 1)*sizeof(uint32_t)
+ * is not. */
+static size_t ffv1_vk_results_stride(const VulkanEncodeFFv1Context *fv)
+{
+    const FFV1Context *f = &fv->ctx;
+    size_t align = fv->s.props.properties.limits.minStorageBufferOffsetAlignment;
+    if (align < sizeof(uint32_t))
+        align = sizeof(uint32_t);
+    return FFALIGN((f->max_slice_count + 1)*sizeof(uint32_t), align);
+}
+
+/* The RGB range coder encoder keeps the reversible colour transform ring in a
+ * storage buffer rather than a storage image (ffv1_enc_rgb.comp.glsl). This
+ * mirrors the shader's #if there: the plain range coder variant, i.e. not
+ * Golomb, not the float/remap variant and not Bayer. */
+static int rgb_tmp_is_buffer(const VulkanEncodeFFv1Context *fv)
+{
+    const FFV1Context *f = &fv->ctx;
+    return fv->is_rgb && !f->bayer && !f->remap_mode &&
+           f->ac != AC_GOLOMB_RICE;
+}
+
 extern const char *ff_source_common_comp;
 extern const char *ff_source_rangecoder_comp;
 extern const char *ff_source_ffv1_vlc_comp;
@@ -394,7 +422,7 @@ static int vulkan_encode_ffv1_submit_frame(AVCodecContext *avctx,
 
     AVFrame *tmp = NULL;
     VkImageView tmp_views[AV_NUM_DATA_POINTERS];
-    if (fv->is_rgb) {
+    if (fv->is_rgb && !rgb_tmp_is_buffer(fv)) {
         /* Create a temporaty frame */
         tmp = av_frame_alloc();
         if (!(tmp)) {
@@ -455,7 +483,7 @@ static int vulkan_encode_ffv1_submit_frame(AVCodecContext *avctx,
     RET(ff_vk_exec_add_dep_frame(&fv->s, exec, src,
                                  VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
                                  VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT));
-    if (fv->is_rgb)
+    if (fv->is_rgb && !rgb_tmp_is_buffer(fv))
         RET(ff_vk_exec_add_dep_frame(&fv->s, exec, tmp,
                                      VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
                                      VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT));
@@ -541,8 +569,21 @@ static int vulkan_encode_ffv1_submit_frame(AVCodecContext *avctx,
 
     vk->CmdDispatch(exec->buf, fv->ctx.num_h_slices, fv->ctx.num_v_slices, 1);
 
-    /* Clean up temporary image if needed */
-    if (fv->is_rgb) {
+    /* Prepare the colour transform ring for this frame. Both variants must
+     * start zeroed: the first lines of a slice read neighbours that were never
+     * written, and the encoder relies on them being zero. */
+    if (rgb_tmp_is_buffer(fv)) {
+        size_t tmp_off = fd->idx*fv->rgb_tmp_size;
+        FFVkBuffer *ring = &fv->rgb_tmp;
+
+        vk->CmdFillBuffer(exec->buf, ring->buf,
+                          ring->virtual_offset + tmp_off,
+                          fv->rgb_tmp_size, 0);
+        ff_vk_buf_barrier(buf_bar[nb_buf_bar++], ring,
+                          TRANSFER_BIT, TRANSFER_WRITE_BIT, NONE_KHR,
+                          COMPUTE_SHADER_BIT, SHADER_READ_BIT, SHADER_WRITE_BIT,
+                          tmp_off, fv->rgb_tmp_size);
+    } else if (fv->is_rgb) {
         AVVkFrame *vkf = (AVVkFrame *)tmp->data[0];
         vkf->layout[0] = VK_IMAGE_LAYOUT_UNDEFINED;
         vkf->access[0] = VK_ACCESS_2_NONE;
@@ -628,7 +669,7 @@ static int vulkan_encode_ffv1_submit_frame(AVCodecContext *avctx,
                         VK_IMAGE_LAYOUT_GENERAL,
                         VK_QUEUE_FAMILY_IGNORED);
 
-    if (fv->is_rgb)
+    if (fv->is_rgb && !rgb_tmp_is_buffer(fv))
         ff_vk_frame_barrier(&fv->s, exec, tmp, img_bar, &nb_img_bar,
                             VK_PIPELINE_STAGE_2_CLEAR_BIT,
                             VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
@@ -655,7 +696,7 @@ static int vulkan_encode_ffv1_submit_frame(AVCodecContext *avctx,
     ff_vk_shader_update_desc_buffer(&fv->s, exec,
                                     &fv->enc, 1, 1, 0,
                                     &fv->results_buf,
-                                    fd->idx*(f->max_slice_count + 1)*sizeof(uint32_t),
+                                    fd->idx*ffv1_vk_results_stride(fv),
                                     f->slice_count*sizeof(uint32_t),
                                     VK_FORMAT_UNDEFINED);
     ff_vk_shader_update_desc_buffer(&fv->s, exec, &fv->enc,
@@ -669,7 +710,13 @@ static int vulkan_encode_ffv1_submit_frame(AVCodecContext *avctx,
                                   1, 3,
                                   VK_IMAGE_LAYOUT_GENERAL,
                                   VK_NULL_HANDLE);
-    if (fv->is_rgb)
+    if (rgb_tmp_is_buffer(fv))
+        ff_vk_shader_update_desc_buffer(&fv->s, exec, &fv->enc, 1, 4, 0,
+                                        &fv->rgb_tmp,
+                                        fd->idx*fv->rgb_tmp_size,
+                                        fv->rgb_tmp_size,
+                                        VK_FORMAT_UNDEFINED);
+    else if (fv->is_rgb)
         ff_vk_shader_update_img_array(&fv->s, exec, &fv->enc,
                                       tmp, tmp_views,
                                       1, 4,
@@ -720,7 +767,7 @@ static int vulkan_encode_ffv1_submit_frame(AVCodecContext *avctx,
     /* Gather the per-slice slots into the packet buffer, in the same
      * submission. */
     RET(ff_vk_seg_gather(&fv->s, exec, &fv->gather,
-                         &fv->results_buf, fd->idx*(f->max_slice_count + 1)*sizeof(uint32_t),
+                         &fv->results_buf, fd->idx*ffv1_vk_results_stride(fv),
                          f->slice_count,
                          out_data_buf, (out_data_buf->size / f->slice_count) & ~(size_t)15,
                          compacted_buf, 0, 0));
@@ -769,7 +816,7 @@ static int get_packet(AVCodecContext *avctx, FFVkExecContext *exec,
     ff_vk_exec_wait(&fv->s, exec);
 
     /* Invalidate the slice sizes and the packed size if needed */
-    size_t res_off = fd->idx*(f->max_slice_count + 1)*sizeof(uint32_t);
+    size_t res_off = fd->idx*ffv1_vk_results_stride(fv);
     size_t total_off = res_off + f->slice_count*sizeof(uint32_t);
     if (!(fv->results_buf.flags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) {
         VkMappedMemoryRange invalidate_data = {
@@ -1152,7 +1199,8 @@ static int init_encode_shader(AVCodecContext *avctx, VkSpecializationInfo *sl)
             .elems  = av_pix_fmt_count_planes(fv->s.frames->sw_format),
         },
         { /* tmp */
-            .type   = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+            .type   = rgb_tmp_is_buffer(fv) ? VK_DESCRIPTOR_TYPE_STORAGE_BUFFER :
+                                              VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
             .stages = VK_SHADER_STAGE_COMPUTE_BIT,
         },
         { /* fltmap */
@@ -1408,7 +1456,7 @@ static av_cold int vulkan_encode_ffv1_init(AVCodecContext *avctx)
     if (err < 0)
         return err;
 
-    if (fv->is_rgb)
+    if (fv->is_rgb && !rgb_tmp_is_buffer(fv))
         RET(init_indirect(avctx, fv->ctx.use32bit ?
                                  AV_PIX_FMT_RGBA128 : AV_PIX_FMT_RGBA64));
 
@@ -1469,7 +1517,7 @@ static av_cold int vulkan_encode_ffv1_init(AVCodecContext *avctx)
 
     /* Buffers */
     RET(ff_vk_create_buf(&fv->s, &fv->results_buf,
-                         fv->async_depth*(f->max_slice_count + 1)*sizeof(uint32_t),
+                         fv->async_depth*ffv1_vk_results_stride(fv),
                          NULL, NULL,
                          VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
                          VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT |
@@ -1484,6 +1532,20 @@ static av_cold int vulkan_encode_ffv1_init(AVCodecContext *avctx)
                          VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT));
     RET(ff_vk_map_buffer(&fv->s, &fv->order_buf, NULL, 0));
 
+    /* RGB colour transform ring, one share per in-flight context */
+    if (rgb_tmp_is_buffer(fv)) {
+        fv->rgb_tmp_size = (size_t)fv->s.frames->width *
+                           f->num_v_slices*RGB_LINECACHE*
+                           sizeof(uint32_t)*4;
+
+        RET(ff_vk_create_buf(&fv->s, &fv->rgb_tmp,
+                             fv->async_depth*fv->rgb_tmp_size,
+                             NULL, NULL,
+                             VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                             VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                             VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT));
+    }
+
 fail:
     return err;
 }
@@ -1522,6 +1584,7 @@ static av_cold int vulkan_encode_ffv1_close(AVCodecContext *avctx)
 
     ff_vk_free_buf(&fv->s, &fv->results_buf);
     ff_vk_free_buf(&fv->s, &fv->order_buf);
+    ff_vk_free_buf(&fv->s, &fv->rgb_tmp);
 
     ff_vk_free_buf(&fv->s, &fv->consts_buf);
 
diff --git a/libavcodec/vulkan/ffv1_common.glsl b/libavcodec/vulkan/ffv1_common.glsl
