diff --git a/libavcodec/vulkan/ffv1_enc_rgb.comp.glsl b/libavcodec/vulkan/ffv1_enc_rgb.comp.glsl
index 90d136be1f..68283b44a8 100644
--- a/libavcodec/vulkan/ffv1_enc_rgb.comp.glsl
+++ b/libavcodec/vulkan/ffv1_enc_rgb.comp.glsl
@@ -24,7 +24,44 @@
 #extension GL_GOOGLE_include_directive : require
 #extension GL_EXT_shader_image_load_formatted : require
 
+#define RGB
+
+/* The range coder variant keeps the reversible colour transform ring in a
+ * device-local storage buffer. Every line is written and then read back by the
+ * same workgroup immediately after, which a buffer handles much better than a
+ * storage image. */
+#if !defined(GOLOMB) && !defined(FLOAT)
+#define RGB_TMP_BUFFER
+
+#extension GL_EXT_scalar_block_layout : require
+
+layout (set = 1, binding = 4, scalar) buffer rgb_tmp_buf {
+    uvec4 rgb_tmp[];
+};
+
+uvec4 tmp_load(ivec2 pos, uint w)
+{
+    return rgb_tmp[uint(pos.y)*w + uint(pos.x)];
+}
+
+void tmp_store(ivec2 pos, uint w, uvec4 v)
+{
+    rgb_tmp[uint(pos.y)*w + uint(pos.x)] = v;
+}
+
+#define SURF_LOAD(surf, addr)       tmp_load((addr), uint(img_size[0]))
+#define SURF_STORE(surf, addr, val) tmp_store((addr), uint(img_size[0]), (val))
+
+/* encode_line()/encode_line_pcm() still take a surface; in buffer mode the
+ * accessors ignore it, so hand them the first plane of the source image. */
+#define RGB_TMP_SURF src[0]
+
+#else
+
 layout (set = 1, binding = 4) uniform uimage2D tmp;
 
-#define RGB
+#define RGB_TMP_SURF tmp
+
+#endif
+
 #include "ffv1_enc.comp.glsl"
